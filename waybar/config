{
	"ipc": true,
	"layer": "top",
	"position": "top",
	"height": 30,
	"margin-top": 10,
	"margin-left": 16,
	"margin-right": 16,
	"modules-left": [
		"custom/launcher",
		"custom/updates",
		"clock"
	],
	"modules-center": [
		"custom/swaync",
		"hyprland/workspaces",
		"custom/powerprofile"
	],
	"modules-right": [
		"battery",
		"pulseaudio",
		"network",
		"custom/batteryhealth"
	],
	"custom/updates": {
		"exec": "~/.config/waybar/scripts/updates.sh",
		"interval": 1800,
		"format": "{}",
		"tooltip": false
	},
	"custom/launcher": {
		"format": "",
		"on-click": "rofi -show drun",
		"tooltip": false
	},
	"hyprland/workspaces": {
		"format": "{id}",
		"format-icons": {
			"default": "",
			"empty": "",
			"urgent": ""
		},
		"persistent/workspaces": {
			"*": 5
		},
		"on-click": "activate",
		"on-scroll-up": "hyprctl dispatch workspace e+1",
		"on-scroll-down": "hyprctl dispatch workspace e-1"
	},
	"clock": {
		"format": "󰥔  {:%I:%M %p}",
		"format-alt": "󰃰  {:%A, %d %b}",
		"tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
	},
	"custom/batteryhealth": {
		"exec": "upower -i /org/freedesktop/UPower/devices/battery_BAT0 | grep 'capacity:' | awk '{print $2}'",
		"interval": 300,
		"format": "󱈑 {}",
		"tooltip": false
	},
	"network": {
		"interface": "wl*",
		"interval": 5,
		"format-wifi": "󰤨    {essid}",
		"format-ethernet": "󰈀  {ifname}",
		"format-disconnected": "󰤭  No Signal",
		"format-linked": "󰈀  No IP",
		"tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}",
		"on-click": "~/.config/waybar/scripts/network-menu.sh"
	},
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": "󰝟  Muted",
		"format-icons": {
			"headphone": "󰋋",
			"hands-free": "󰋎",
			"headset": "󰋎",
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"on-click": "~/.config/waybar/scripts/audio-menu.sh",
		"on-click-right": "~/.config/waybar/scripts/audio-menu.sh source",
		"scroll-step": 5
	},
	"custom/powerprofile": {
		"exec": "~/.config/waybar/scripts/powerprofile.sh",
		"interval": 5,
		"format": "{}",
		"on-click": "~/.config/waybar/scripts/powerprofile.sh cycle",
		"tooltip": false
	},
	"custom/swaync": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂚",
			"dnd-notification": "󰂛",
			"dnd-none": "󰂛",
			"inhibited-notification": "󱅫",
			"inhibited-none": "󰂚",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰂛"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}  {capacity}%",
		"format-charging": "󰂄  {capacity}%",
		"format-plugged": "󰚥  {capacity}%",
		"format-icons": [
			" ",
			" ",
			" ",
			" ",
			" "
		]
	}
}
